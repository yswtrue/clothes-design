# Production Environment Variables Template for Docker
# Copy this file to .env and configure the values for your production environment

# === DATABASE ===
# Option 1: Use individual components (URL auto-composed)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=clothes_design_prod

# Option 2: Or provide full URL directly (takes precedence)
# DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@postgres:5432/clothes_design_prod

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# === REDIS ===
# Option 1: Use individual components (URL auto-composed)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# Option 2: Or provide full URLs directly (takes precedence)
# REDIS_URL=redis://redis:6379/0
# REDIS_QUEUE_URL=redis://redis:6379/1

REDIS_MAX_CONNECTIONS=20

# === AI PROVIDERS ===
# Configure AI provider credentials in the Admin panel or /api/ai-providers.
# Tokens are stored in the database and should not be set in this env file.

# === STORAGE (S3-compatible or local) ===
# Storage type: local or s3 (use external S3-compatible storage for production)
STORAGE_TYPE=s3

# S3-compatible storage configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=clothes-design-prod
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=us-east-1

# === AUTHENTICATION ===
# JWT Configuration
# IMPORTANT: Change JWT_SECRET to a strong random value!
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_VALUE
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# === URLs ===
# Service URLs as accessed from within Docker network
FRONTEND_URL=http://frontend:3000
BACKEND_URL=http://backend:8000
BACKEND_API_URL=http://backend:8000

# Docker Compose profiles. Leave empty to skip optional services.
# Set to "frontend" to deploy the frontend container.
COMPOSE_PROFILES=

# Traefik routing
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_BACKEND_HOST=api.example.com
TRAEFIK_FRONTEND_HOST=example.com

# === ENVIRONMENT & LOGGING ===
LOG_LEVEL=info
ENVIRONMENT=production

# === WORKER CONFIGURATION ===
WORKER_CONCURRENCY=4
