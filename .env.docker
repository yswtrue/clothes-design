# Production Environment Variables Template for Docker
# Copy this file to .env and configure the values for your production environment

# === DATABASE ===
# PostgreSQL connection string
# In Docker Compose, service name 'postgres' is used as hostname
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@postgres:5432/clothes_design_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=clothes_design_prod

# === REDIS ===
# Redis connection strings
# In Docker Compose, service name 'redis' is used as hostname
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1

# === AI SERVICES ===
# OpenAI - For general AI features
OPENAI_API_KEY=sk_prod_your_production_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ORG_ID=

# Stability AI - For image generation
STABILITY_AI_API_KEY=sk-your_production_stability_key_here

# Vectorizer.ai - For image vectorization/tracing
VECTORIZER_AI_API_KEY=your_production_vectorizer_key_here

# Replicate - For additional ML models
REPLICATE_API_TOKEN=your_production_replicate_token_here

# === STORAGE (MinIO / S3) ===
# Storage type: local or s3 (use s3 for production with MinIO)
STORAGE_TYPE=s3

# S3 / MinIO Configuration
# In Docker Compose, MinIO service is accessed as 'minio' hostname
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_THIS_PASSWORD
AWS_S3_BUCKET=clothes-design-prod
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_USE_PATH_STYLE=true

# === AUTHENTICATION ===
# JWT Configuration
# IMPORTANT: Change JWT_SECRET to a strong random value!
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_VALUE
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# === URLs ===
# Service URLs as accessed from within Docker network
FRONTEND_URL=http://frontend:3000
BACKEND_URL=http://backend:8000
BACKEND_API_URL=http://backend:8000/api
NEXT_PUBLIC_API_URL=http://backend:8000

# === FEATURE FLAGS & LOGGING ===
DEBUG=false
LOG_LEVEL=info
ENVIRONMENT=production

# === WORKER CONFIGURATION ===
WORKER_CONCURRENCY=4
WORKER_QUEUE_PREFIX=clothes-design

# === AI MODEL PARAMETERS ===
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_QUALITY=95
IMAGE_FORMAT=png

# === DESIGN PARAMETERS ===
MAX_DESIGN_LAYERS=50
MAX_PRINT_AREA_SIZE=100000000
SUPPORTED_PRINT_AREAS=chest,back,sleeve,pantleg,fullfront,fullback

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# === CACHING ===
CACHE_TTL=3600
SESSION_TIMEOUT=1800
