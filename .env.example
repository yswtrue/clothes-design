# Development Environment Variables Template
# Copy this file to .env.local and configure for your development setup

# === DATABASE ===
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/clothes_design_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/clothes_design_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothes_design_dev

# === REDIS ===
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1

# === AI SERVICES ===
# OpenAI - For general AI features
OPENAI_API_KEY=sk_test_your_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ORG_ID=

# Stability AI - For image generation
STABILITY_AI_API_KEY=sk-your_stability_key_here
STABILITY_AI_ENGINE_ID=stable-diffusion-3

# Vectorizer.ai - For image vectorization/tracing
VECTORIZER_AI_API_KEY=your_vectorizer_key_here

# Dynamic Mockups - For mockup generation
DYNAMIC_MOCKUPS_API_KEY=your_mockups_key_here

# Replicate - For additional ML models
REPLICATE_API_TOKEN=your_replicate_token_here

# === STORAGE ===
# Storage Type Configuration (local for development, s3 for production)
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads

# S3 / Object Storage Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=clothes-design-dev
AWS_S3_ENDPOINT=http://127.0.0.1:9000
AWS_S3_USE_PATH_STYLE=true

# === AUTHENTICATION ===
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# === URLs ===
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000/api

# === FEATURE FLAGS ===
DEBUG=false
LOG_LEVEL=info
ENVIRONMENT=development

# === WORKER CONFIGURATION ===
WORKER_CONCURRENCY=4
WORKER_QUEUE_PREFIX=clothes-design

# === AI MODEL PARAMETERS ===
# Image generation defaults
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_QUALITY=95
IMAGE_FORMAT=png

# Design parameters
MAX_DESIGN_LAYERS=50
MAX_PRINT_AREA_SIZE=100000000
SUPPORTED_PRINT_AREAS=chest,back,sleeve,pantleg,fullfront,fullback

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# === CACHE ===
CACHE_TTL=3600
SESSION_TIMEOUT=1800
