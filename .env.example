# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothes_design
POSTGRES_PORT=5432

# Full database URL for application
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothes_design

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6379/1
REDIS_MAX_CONNECTIONS=10

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# Storage type: "local" or "s3"
STORAGE_TYPE=local

# Local storage path (if STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./uploads

# S3/MinIO configuration (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=clothes-design
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=false
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=false

# MinIO ports (Docker only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===========================================
# APPLICATION URLS
# ===========================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ===========================================
# AI PROVIDER API KEYS (Fallback)
# ===========================================
# Note: AI providers can be configured via Admin panel (stored in database)
# These env vars are used as fallback when no DB config exists

# OpenAI (GPT-4V for image analysis)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo

# Replicate (image generation + upscaling)
REPLICATE_API_TOKEN=r8_your-replicate-token

# Vectorizer.ai (SVG tracing)
VECTORIZER_API_KEY=your-vectorizer-ai-key

# ===========================================
# WORKER CONFIGURATION
# ===========================================
WORKER_CONCURRENCY=4

# ===========================================
# ENVIRONMENT & LOGGING
# ===========================================
ENVIRONMENT=development
LOG_LEVEL=info

# ===========================================
# CORS CONFIGURATION (Development)
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
