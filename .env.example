# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Option 1: Use individual components (URL auto-composed)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clothes_design

# Option 2: Or provide full URL directly (takes precedence)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothes_design

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Option 1: Use individual components (URL auto-composed)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# Option 2: Or provide full URLs directly (takes precedence)
# REDIS_URL=redis://localhost:6379/0
# REDIS_QUEUE_URL=redis://localhost:6379/1

REDIS_MAX_CONNECTIONS=10

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# Storage type: "local" or "s3"
STORAGE_TYPE=local

# Local storage path (if STORAGE_TYPE=local)
LOCAL_STORAGE_PATH=./uploads

# S3-compatible storage configuration (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=clothes-design
AWS_S3_ENDPOINT_URL=
# Optional public URL host for S3-compatible storage, e.g. R2 custom domain.
# Include a path prefix if your CDN exposes the bucket under a subpath.
# Example: cdn.example.com/bucket-name
# Leave empty to use AWS_S3_ENDPOINT_URL for generated file URLs.
AWS_S3_CUSTOM_DOMAIN=
# Optional signing region for S3-compatible storage. Use "auto" for Cloudflare R2.
AWS_S3_REGION_NAME=
AWS_S3_USE_SSL=false
AWS_DEFAULT_ACL=
AWS_QUERYSTRING_AUTH=false

# ===========================================
# APPLICATION URLS
# ===========================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000

# Docker Compose profiles. Leave empty to skip optional services.
# Set to "frontend" to deploy the frontend container.
COMPOSE_PROFILES=

# Backend API replicas for ordinary Docker Compose scaling.
BACKEND_REPLICAS=2

# Traefik routing (Docker only)
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_BACKEND_HOST=api.localhost
TRAEFIK_FRONTEND_HOST=localhost

# ===========================================
# WORKER CONFIGURATION
# ===========================================
WORKER_CONCURRENCY=4

# ===========================================
# ENVIRONMENT & LOGGING
# ===========================================
ENVIRONMENT=development
LOG_LEVEL=info

# AI provider credentials are configured in the Admin panel or
# /api/ai-providers and stored in the database, not in this env file.
